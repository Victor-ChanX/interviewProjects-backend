# docker-compose.yml 的变量（Dokploy：粘到应用的 Environment 页面；本机：复制成 .env）。
# 两个密钥各用 openssl rand -hex 32 生成，彼此不同；数据库口令由 Dokploy 生成，别抄进仓库。

# 数据库：Dokploy 里单独创建的 Postgres，复制它 Connection 页的 Internal Connection URL
# （主机名是那个数据库的 App Name）。本机 --profile local-db 时写 postgresql://gmp:gmp@postgres:5432/gmp
DATABASE_URL=postgresql://postgres:change-me@<数据库的 App Name>:5432/postgres

# access token（HS256）签名密钥
JWT_SECRET=change-me

# 后端与 llm-agent 之间的管理令牌（控制台「模型设置」经后端转发到 llm-agent 时带上）
LLM_AGENT_ADMIN_TOKEN=change-me

# Agent 服务：默认用模拟器；接真实模型（Claude / Gemini）改成 http://llm-agent:8300 后重新部署
AGENT_URL=http://agent-sim:8200

# 媒体文件（题目 C1）保留天数，超过的由后端定期删除；文件本身在 media-data 卷里
MEDIA_RETENTION_DAYS=30

# 演示用：1 = 控制台群详情出现「模拟外部发言」（admin 可代推外部成员消息、触发 Agent）；
# 这套 compose 的网关就是模拟器，所以演示环境开着；0 关闭
SIM_CONTROLS_ENABLED=1

# 站点已配 HTTPS 保持 1；只有 http 时设 0（否则浏览器不保存 refresh cookie，刷新页面会掉登录）
COOKIE_SECURE=1
