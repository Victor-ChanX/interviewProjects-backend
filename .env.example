PORT=8000
DATABASE_URL=postgres://user@localhost:5432/group_message_platform
# access token（HS256）签名密钥，必填；换成随机长串（openssl rand -hex 32）
JWT_SECRET=change-me-to-a-random-secret-0123456789abcdef
GATEWAY_URL=http://localhost:8100
AGENT_URL=http://localhost:8200
# 演示用：1 = 控制台群详情出现「模拟外部发言」（经网关模拟器 /_sim/push）；只在 GATEWAY_URL 指向模拟器时打开
SIM_CONTROLS_ENABLED=1

# ---- 真实 LLM 版 Agent 服务（题目 C2，npm run llm-agent；用它时把上面的 AGENT_URL 改成 http://localhost:8300）----
# 上游只支持 Claude / Gemini（官方 SDK）；服务商、API Key、模型不在这里配：在控制台的「模型设置」里填，存进 LLM_AGENT_CONFIG_FILE。
# 管理令牌：后端与 llm-agent 用同一个值（openssl rand -hex 32），llm-agent 启动必填
LLM_AGENT_ADMIN_TOKEN=change-me-to-a-random-admin-token
# 控制台保存的配置文件（含 API key，chmod 600，已被 .gitignore / .dockerignore 排除）
# LLM_AGENT_CONFIG_FILE=.llm-agent.json
# 一次 /agent/turn 调上游的总预算（含重试），要比 AGENT_TURN_TIMEOUT_MS（默认 12000）小 1–2 秒
# LLM_TIMEOUT_MS=10000
# LLM_AGENT_PORT=8300

# ---- 媒体文件（题目 C1）：message 事件的 mediaUrl 下载到这里，路径记在消息的 localFilePath ----
# MEDIA_DIR=media
# 保留天数，超过的由后端定期删除（正整数）
# MEDIA_RETENTION_DAYS=30
